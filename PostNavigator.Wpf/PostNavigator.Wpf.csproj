<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>Post Navigator</AssemblyTitle>
    <ApplicationIcon>Assets/PostNavigator.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <EmbeddedResource Include="ReadVisiblePosts.js" />
    <EmbeddedResource Include="../sql/upsert_x_post.sql" LogicalName="PostNavigator.Wpf.UpsertXPost.sql" />
    <Resource Include="Assets/PostNavigator.ico" />
  </ItemGroup>
</Project>
