<Window x:Class="PostNavigator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Post Navigator" Width="1240" Height="820" MinWidth="720" MinHeight="590"
        WindowStartupLocation="CenterScreen" Language="ja-JP"
        UseLayoutRounding="True" Background="#E8EDF4" Foreground="#17243A"
        FontFamily="Segoe UI, Yu Gothic UI">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C7D2E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#17243A" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#2A63BE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.43" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2058AC" />
            <Setter Property="BorderBrush" Value="#2058AC" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#14223A" Padding="20,0">
            <DockPanel LastChildFill="True">
                <Button x:Name="SignInButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                        Content="Xにログイン" Style="{StaticResource ActionButton}"
                        IsEnabled="False" Click="OpenSignIn" />
                <TextBlock Text="Post Navigator" Foreground="#FFFFFF" FontSize="22"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F6F8FC" BorderBrush="#C7D2E1"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SearchPanel" IsEnabled="False">
                        <Label Content="Xアカウント" Target="{Binding ElementName=AccountBox}"
                               FontWeight="SemiBold" Padding="0,0,0,7" />
                        <TextBox x:Name="AccountBox" MinHeight="35" Padding="8,0"
                                 VerticalContentAlignment="Center" BorderBrush="#C7D2E1"
                                 KeyDown="SearchOnEnter" TextChanged="AccountChanged" />
                        <TextBlock x:Name="AccountError" Visibility="Collapsed" Margin="0,8,0,0"
                                   Foreground="#9C2626" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <UniformGrid Rows="1" Columns="2" Margin="0,10,0,0">
                            <Button Content="プロフィール" Margin="0,0,4,0" Padding="3,6"
                                    Style="{StaticResource ActionButton}" Click="OpenProfile" />
                            <Button Content="返信タブ" Margin="4,0,0,0" Padding="3,6"
                                    Style="{StaticResource ActionButton}" Click="OpenReplies" />
                        </UniformGrid>

                        <Border Background="#D8E1EC" Height="1" Margin="0,23,0,18" />
                        <TextBlock Text="投稿を検索" FontSize="17" FontWeight="SemiBold" />
                        <Grid Margin="0,14,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="年" Target="{Binding ElementName=YearBox}" Padding="0,0,0,5" />
                                <ComboBox x:Name="YearBox" MinHeight="34" VerticalContentAlignment="Center"
                                          MaxDropDownHeight="320" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="月" Target="{Binding ElementName=MonthBox}" Padding="0,0,0,5" />
                                <ComboBox x:Name="MonthBox" MinHeight="34" VerticalContentAlignment="Center"
                                          SelectedValuePath="Number" DisplayMemberPath="Label" />
                            </StackPanel>
                        </Grid>
                        <Button Content="この期間の投稿を検索" Style="{StaticResource PrimaryButton}"
                                Click="SearchPosts" />
                        <Button x:Name="CapturePostsButton" Content="表示中の投稿を取得" Margin="0,12,0,0"
                                Style="{StaticResource ActionButton}" Click="CaptureVisiblePosts"
                                ToolTip="画面内の投稿を取得してJSONで保存します" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#C7D2E1"
                    BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="47" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="#D8E1EC" BorderThickness="0,0,0,1" Padding="8,5">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button x:Name="BackButton" Content="戻る" Margin="0,0,4,0"
                                        Style="{StaticResource ActionButton}" Click="GoBack" IsEnabled="False" />
                                <Button x:Name="ForwardButton" Content="進む" Margin="0,0,4,0"
                                        Style="{StaticResource ActionButton}" Click="GoForward" IsEnabled="False" />
                                <Button x:Name="ReloadButton" Content="再読込" Margin="0,0,4,0"
                                        Style="{StaticResource ActionButton}" Click="ReloadPage" IsEnabled="False" />
                                <Button x:Name="HomeButton" Content="Xホーム"
                                        Style="{StaticResource ActionButton}" Click="OpenHome" IsEnabled="False" />
                            </StackPanel>
                            <TextBlock x:Name="PageLabel" Text="x.com" Margin="12,0,4,0"
                                       Foreground="#475B74" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <wv:WebView2 x:Name="Browser" Grid.Row="1" Margin="0,0,0,8"
                                 Visibility="Hidden" />
                    <StackPanel x:Name="BrowserNotice" Grid.Row="1" MaxWidth="400" Margin="24"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="BrowserNoticeTitle" Text="ブラウザを起動しています"
                                   FontSize="19" FontWeight="SemiBold" TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="BrowserNoticeDetail" Margin="0,10,0,0" TextAlignment="Center"
                                   TextWrapping="Wrap" Foreground="#475B74" Visibility="Collapsed" />
                        <Button x:Name="RuntimeButton" Content="WebView2のダウンロード"
                                Margin="0,15,0,0" HorizontalAlignment="Center" Visibility="Collapsed"
                                Style="{StaticResource ActionButton}" Click="OpenRuntimeDownload" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="Status" Grid.Row="2" Margin="20,0" Foreground="#475B74"
                   Text="起動中…" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
