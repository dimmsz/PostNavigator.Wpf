<Window x:Class="PostNavigator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Post Navigator" Icon="Assets/PostNavigator.ico"
        Width="1240" Height="820" MinWidth="720" MinHeight="590"
        WindowStartupLocation="CenterScreen" Language="ja-JP"
        UseLayoutRounding="True" Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SignInButton" Content="Xにログイン" Margin="0,0,8,0"
                            IsEnabled="False" Click="OpenSignIn" />
                    <Button Content="設定" Click="OpenSettings" />
                </StackPanel>
                <TextBlock Text="Post Navigator" FontSize="24"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SearchPanel" IsEnabled="False">
                        <Label Content="Xアカウント" Target="{Binding ElementName=AccountBox}"
                               FontWeight="SemiBold" Padding="0,0,0,7" />
                        <TextBox x:Name="AccountBox" MinHeight="34"
                                 KeyDown="SearchOnEnter" TextChanged="AccountChanged" />
                        <TextBlock x:Name="AccountError" Visibility="Collapsed" Margin="0,8,0,0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <UniformGrid Rows="1" Columns="2" Margin="0,10,0,0">
                            <Button Content="プロフィール" Margin="0,0,4,0" Padding="6,5"
                                    Click="OpenProfile" />
                            <Button Content="返信タブ" Margin="4,0,0,0" Padding="6,5"
                                    Click="OpenReplies" />
                        </UniformGrid>

                        <Border Background="{DynamicResource CardStrokeColorDefaultBrush}" Height="1" Margin="0,23,0,18" />
                        <TextBlock Text="投稿を検索" FontSize="17" FontWeight="SemiBold" />
                        <Grid Margin="0,14,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="年" Target="{Binding ElementName=YearBox}" Padding="0,0,0,5" />
                                <ComboBox x:Name="YearBox" MinHeight="34" VerticalContentAlignment="Center"
                                          MaxDropDownHeight="320" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="月" Target="{Binding ElementName=MonthBox}" Padding="0,0,0,5" />
                                <ComboBox x:Name="MonthBox" MinHeight="34" VerticalContentAlignment="Center"
                                          SelectedValuePath="Number" DisplayMemberPath="Label" />
                            </StackPanel>
                        </Grid>
                        <Button Content="この期間の投稿を検索" Style="{DynamicResource AccentButtonStyle}" MinHeight="36"
                                HorizontalAlignment="Stretch" Click="SearchPosts" />
                        <Button x:Name="CapturePostsButton" Content="表示中の投稿を取得" Margin="0,12,0,0"
                                HorizontalAlignment="Stretch" Click="CaptureVisiblePosts"
                                ToolTip="画面内の投稿を取得してデータベースに保存します" />
                        <CheckBox x:Name="AutomaticCaptureSwitch" Content="自動取得" Margin="0,12,0,0"
                                  Checked="AutomaticCaptureChanged" Unchecked="AutomaticCaptureChanged"
                                  ToolTip="表示中の投稿を自動で取得してデータベースに保存します">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="SwitchOutline" MinHeight="34" Padding="4,2"
                                            CornerRadius="4" BorderThickness="1" BorderBrush="Transparent"
                                            Background="Transparent">
                                        <DockPanel VerticalAlignment="Center">
                                            <Border x:Name="SwitchTrack" DockPanel.Dock="Right"
                                                    Width="38" Height="20" CornerRadius="10" BorderThickness="1"
                                                    BorderBrush="{DynamicResource ControlStrongFillColorDefaultBrush}">
                                                <Ellipse x:Name="SwitchThumb" Width="12" Height="12" Margin="3,0"
                                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                                         Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Border>
                                            <ContentPresenter Margin="0,0,8,0" VerticalAlignment="Center"
                                                              RecognizesAccessKey="True" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="SwitchTrack" Property="Background"
                                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="Transparent" />
                                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="SwitchThumb" Property="Fill"
                                                    Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="SwitchOutline" Property="BorderBrush"
                                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="SwitchOutline" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                        <TextBlock x:Name="CaptureProgress" Margin="4,6,0,0" FontSize="12"
                                   TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="ExportHtmlButton" Content="この期間の投稿をHTMLに書き出す" Margin="0,12,0,0"
                                HorizontalAlignment="Stretch" Click="ExportHtml" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,5">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button x:Name="BackButton" Content="戻る" Margin="0,0,4,0"
                                        Click="GoBack" IsEnabled="False" />
                                <Button x:Name="ForwardButton" Content="進む" Margin="0,0,4,0"
                                        Click="GoForward" IsEnabled="False" />
                                <Button x:Name="ReloadButton" Content="再読込" Margin="0,0,4,0"
                                        Click="ReloadPage" IsEnabled="False" />
                                <Button x:Name="HomeButton" Content="Xホーム"
                                        Click="OpenHome" IsEnabled="False" />
                            </StackPanel>
                            <TextBlock x:Name="PageLabel" Text="x.com" Margin="12,0,4,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <wv:WebView2 x:Name="Browser" Grid.Row="1" Margin="1,0,1,1" Visibility="Hidden" />
                    <StackPanel x:Name="BrowserNotice" Grid.Row="1" MaxWidth="400" Margin="24"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="BrowserNoticeTitle" Text="ブラウザを起動しています"
                                   FontSize="19" FontWeight="SemiBold" TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="BrowserNoticeDetail" Margin="0,10,0,0" TextAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                        <Button x:Name="RuntimeButton" Content="WebView2のダウンロード"
                                Margin="0,15,0,0" HorizontalAlignment="Center" Visibility="Collapsed"
                                Click="OpenRuntimeDownload" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="Status" Grid.Row="2" Margin="20,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="起動中…" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
